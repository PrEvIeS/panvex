# Copy to `.env` next to docker-compose.senko.yml and fill in the values.
# `.env` is gitignored — do NOT commit the real key.
#
# Generate a fresh key on first install:
#   openssl rand -hex 32
#
# This key encrypts the embedded CA private key at rest. Rotating it
# requires manual re-encryption of the CA — keep it stable across upgrades.
PANVEX_ENCRYPTION_KEY=
